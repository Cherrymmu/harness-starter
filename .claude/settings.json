{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cat | bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-naming.sh\"",
            "timeout": 10,
            "statusMessage": "네이밍 규칙 검사 중"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cat | bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-paid-resource.sh\"",
            "timeout": 10,
            "statusMessage": "AWS 프리티어 범위 검사 중"
          }
        ]
      }
    ]
  }
}
