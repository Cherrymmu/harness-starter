# 로컬 트랙 양식 — 복사해서 .env.local로 만들어 쓴다 (.env.local은 git에 올라가지 않음)
#   cp .env.local.example .env.local
# 아래 값은 내 노트북 Docker 안에서만 쓰는 실습용 계정이라 그대로 써도 된다
POSTGRES_USER=apt_user
POSTGRES_PASSWORD=apt_pass
POSTGRES_DB=apt
POSTGRES_PORT=5432

# collector.py / 스크립트에서 쓸 접속 문자열
DATABASE_URL=postgresql://apt_user:apt_pass@localhost:5432/apt
