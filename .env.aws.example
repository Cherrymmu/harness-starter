# AWS 트랙 — 이 파일을 복사해서 ".env.aws"로 만들고 실제 값으로 채운다.
#   cp .env.aws.example .env.aws
# .env.aws는 실제 비밀값(마스터 암호 등)이 들어가므로 git에 커밋하지 않는다(.gitignore 대상).

# aws_preclass_setup.md 6번 단계에서 받은 RDS 엔드포인트 (예: apt-capstone-db.xxxxxxxx.ap-northeast-2.rds.amazonaws.com)
POSTGRES_HOST=<RDS 엔드포인트를 여기에>
POSTGRES_PORT=5432
POSTGRES_USER=<RDS 생성 시 설정한 마스터 사용자 이름>
POSTGRES_PASSWORD=<RDS 생성 시 설정한 마스터 암호>
POSTGRES_DB=apt

# collector.py / 스크립트에서 쓸 접속 문자열 (위 값과 동일하게 맞춰서 채울 것)
DATABASE_URL=postgresql://<사용자>:<암호>@<RDS 엔드포인트>:5432/apt
